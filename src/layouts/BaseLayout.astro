---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import {
  alternatesFor,
  defaultLocale,
  ogLocales,
  resolveLocale,
  useTranslations,
  type Locale,
} from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * URL of this page in each locale where it exists (hreflang + language switcher).
   * Defaults to every locale; case studies pass only the translations they have.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {
  title,
  description = t('site.description'),
  ogImage,
  noindex = false,
  alternates = alternatesFor(Astro.url.pathname),
} = Astro.props;
const fullTitle = title
  ? `${title} — ${site.brand}`
  : t('site.defaultTitle', { person: site.person, role: t('site.role'), brand: site.brand });
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const hreflangs = Object.entries(alternates).map(([lang, path]) => ({
  lang,
  href: new URL(path, Astro.site).href,
}));
const xDefault = alternates[defaultLocale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Early JS flag: avoids flashes in progressive enhancements (e.g. the rocket flight). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex &&
      hreflangs.length > 1 &&
      hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {!noindex && hreflangs.length > 1 && xDefault && (
      <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#12131a" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skipToContent')}
    </a>
    <SiteHeader alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
