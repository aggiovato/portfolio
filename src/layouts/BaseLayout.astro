---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import ogDefaultEn from '../assets/og/default-en.png';
import ogDefaultEs from '../assets/og/default-es.png';
import ogDefaultIt from '../assets/og/default-it.png';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import PageSky from '../components/PageSky.astro';
import { nav, site } from '../data/site';
import { hasNotes } from '../lib/content/notes';
import { shareImage } from '../lib/share-image';
import {
  alternatesFor,
  defaultLocale,
  localizePath,
  ogLocales,
  resolveLocale,
  useTranslations,
  type Locale,
} from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Share image (cover); without one, the locale's default card (scripts/og-default.mjs). */
  ogImage?: { src: ImageMetadata; alt: string };
  /** Articles (notes, case studies): og:type article with its dates and topics. */
  article?: { publishedTime?: Date; modifiedTime?: Date; tags?: readonly string[] };
  /** Structured data for this page, added to the site's graph (WebSite + Person). */
  jsonLd?: Record<string, unknown>;
  /** The shared night sky behind the top of the page; the home and case studies draw their own. */
  sky?: boolean;
  /** False when the page closes with its own subscription form, so the footer does not repeat it. */
  footerSubscribe?: boolean;
  noindex?: boolean;
  /**
   * URL of this page in each locale where it exists (hreflang + language switcher).
   * Defaults to every locale; case studies pass only the translations they have.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {
  title,
  description = t('site.description'),
  ogImage,
  article,
  jsonLd,
  sky = true,
  footerSubscribe = true,
  noindex = false,
  alternates = alternatesFor(Astro.url.pathname),
} = Astro.props;
const fullTitle = title
  ? `${title} — ${site.brand}`
  : t('site.defaultTitle', { person: site.person, brand: site.brand });
// Sections without content stay out of the menu (§7).
const notesOpen = await hasNotes();
const navItems = nav.filter((item) => !('requires' in item) || notesOpen);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Share image: the page's cover, or the locale's default card (see src/lib/share-image.ts).
const defaultOg: Record<Locale, ImageMetadata> = { en: ogDefaultEn, es: ogDefaultEs, it: ogDefaultIt };
const og = ogImage ?? { src: defaultOg[locale], alt: t('og.defaultAlt') };
const ogUrl = new URL(await shareImage(og.src), Astro.site).href;

// Structured data (schema.org): who the site is about, plus whatever the page describes.
const siteUrl = new URL('/', Astro.site).href;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: site.brand,
      inLanguage: locale,
      author: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: site.person,
      url: siteUrl,
      jobTitle: t('site.role'),
      sameAs: [site.links.github, site.links.linkedin],
    },
    ...(jsonLd
      ? [
          {
            ...jsonLd,
            url: canonical.href,
            inLanguage: locale,
            image: ogUrl,
            author: { '@id': `${siteUrl}#person` },
          },
        ]
      : []),
  ],
};
const hreflangs = Object.entries(alternates).map(([lang, path]) => ({
  lang,
  href: new URL(path, Astro.site).href,
}));
const xDefault = alternates[defaultLocale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Early JS flag: avoids flashes in progressive enhancements (e.g. the rocket flight). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex &&
      hreflangs.length > 1 &&
      hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {/* Feed autodiscovery: readers find the notes feed from any page (no visible link). */}
    {notesOpen && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${t('notes.title')} — ${site.brand}`}
        href={new URL(localizePath('/notes/rss.xml', locale), Astro.site).href}
      />
    )}
    {!noindex && hreflangs.length > 1 && xDefault && (
      <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />
    )}
    <!--
      Speculation Rules (no JS, ignored where unsupported): prerender internal pages when a link is
      hovered or pressed, so navigation and its view transition start without waiting for the network.
    -->
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
      })}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#12131a" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
    )}
    {article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skipToContent')}
    </a>
    <SiteHeader alternates={alternates} nav={navItems} />
    <main id="main" tabindex="-1" class:list={[sky && 'has-sky']}>
      {sky && <PageSky />}
      <slot />
    </main>
    <SiteFooter nav={navItems} subscribe={footerSubscribe} />
    <BackToTop />
  </body>
</html>

<style>
  /* Positioning context for the page sky, behind the first section. Not on the home: its rocket
     flies above the footer, which an isolated <main> would prevent. */
  main.has-sky {
    position: relative;
    isolation: isolate;
  }
</style>
