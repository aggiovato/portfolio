---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeParams, localizePath, resolveLocale, useTranslations } from '../../../i18n';

// Brevo redirects here once the confirmation link in the email is clicked.
// A step in a flow, not a page to find: kept out of search results.
export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t('newsletter.confirmedTitle')} noindex>
  <section class="section">
    <div class="container">
      <p class="path-label">
        ~/<b>newsletter</b>
      </p>
      <h1>{t('newsletter.confirmedTitle')}</h1>
      <p class="lead">{t('newsletter.confirmedBody')}</p>
      <a class="link-underline" href={localizePath('/notes/', locale)}>
        {t('newsletter.backToNotes')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-top: var(--space-2);
    font-size: var(--text-h1-project);
  }
  .lead {
    margin-block: var(--space-6) var(--space-8);
    max-width: 48ch;
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }
</style>
