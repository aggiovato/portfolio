---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Watermark from '../../components/Watermark.astro';
import HorizonArc from '../../components/HorizonArc.astro';
import { getFeaturedProjects, getPublicProjects, projectPath } from '../../lib/content/projects';
import { site } from '../../data/site';
import { localeParams, localizePath, resolveLocale, useTranslations } from '../../i18n';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const featured = await getFeaturedProjects(locale, 8);
// The newest case study (listings are sorted by date), shown under the hero's tagline.
const [newest] = await getPublicProjects(locale);
const latest = newest && { title: newest.data.title, href: projectPath(newest) };

// Each step shows where it happened, in a real case study (by slug). A step whose project is not
// published in this listing simply shows no example.
const projects = await getPublicProjects(locale);
const evidence = (slug: string, example: string) => {
  const project = projects.find((p) => p.data.slug === slug);
  return project && { title: project.data.title, href: projectPath(project), example };
};
const process = [
  {
    title: t('home.process1Title'),
    body: t('home.process1Body'),
    evidence: evidence('yrest', t('home.process1Example')),
  },
  {
    title: t('home.process2Title'),
    body: t('home.process2Body'),
    evidence: evidence('uquiz', t('home.process2Example')),
  },
  {
    title: t('home.process3Title'),
    body: t('home.process3Body'),
    evidence: evidence('yrest-vscode', t('home.process3Example')),
  },
];
---

<BaseLayout sky={false}>
  <Hero latest={latest} />

  <section class="section section--projects work" aria-labelledby="work-title">
    <HorizonArc />
    {featured.length > 0 ? (
      <ProjectCarousel projects={featured}>
        <SectionHeading slot="heading" path="work" id="work-title">
          {t('home.workTitle')}
        </SectionHeading>
        <a slot="footer" class="link-underline" href={localizePath('/work/', locale)}>
          {t('home.seeAllProjects')}
        </a>
      </ProjectCarousel>
    ) : (
      <div class="container">
        <SectionHeading path="work" id="work-title">
          {t('home.workTitle')}
        </SectionHeading>
        <p class="empty">
          {t('home.workEmpty')}{' '}
          <a class="link-underline" href={site.links.github}>
            GitHub
          </a>
          .
        </p>
      </div>
    )}
  </section>

  <section class="section process-section" aria-labelledby="process-title">
    <Watermark kind="liftoff" side="center" />
    <div class="container process-container">
      <SectionHeading path="process" id="process-title">
        {t('home.processTitle')}
      </SectionHeading>
      <ol class="process">
        {process.map((step, i) => (
          <li>
            <span class="step" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            {step.evidence && (
              <p class="evidence">
                <a class="link-underline" href={step.evidence.href}>
                  {step.evidence.title}
                </a>
                : {step.evidence.example}
              </p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about-section" aria-labelledby="about-title">
    <Watermark kind="structure" side="right" />
    <div class="container about">
      <SectionHeading path="about" id="about-title">
        {t('home.aboutTitle')}
      </SectionHeading>
      <div class="about-body">
        <p>{t('home.aboutBody', { person: site.person })}</p>
        <ul class="chip-list" aria-label={t('home.coreStack')}>
          {site.coreStack.map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
        <a class="link-underline" href={localizePath('/about/', locale)}>
          {t('home.moreAboutMe')}
        </a>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  /* Horizon → section heading: ~47 px on mobile, ~93 px on desktop. */
  .work {
    padding-top: 1.25rem;
    padding-bottom: clamp(var(--space-16), 8vw, var(--space-24));
  }

  /*
   * One reading edge for the whole home (DESIGN.md «log»): from 1024 px every section's heading
   * and copy start where the hero's text does, past the log column. Card media may extend left of
   * it; text does not.
   */
  @media (min-width: 1024px) {
    .work {
      padding-top: var(--space-16);
    }

    .work > :global(.container),
    .work :global(.carousel .head),
    .work :global(.carousel .foot),
    .process-container,
    .about,
    :global(main:has([data-launchpad]) .contact-cta > .container) {
      padding-left: calc(max(var(--gutter), env(safe-area-inset-left)) + var(--hero-indent));
    }

    /* The carousel block already sits inside the gutter: only the indent is added. */
    .work :global(.carousel .head),
    .work :global(.carousel .foot) {
      padding-left: var(--hero-indent);
    }
  }

  .empty {
    color: var(--color-text-muted);
  }

  .process {
    display: grid;
    gap: var(--space-12);
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .process li {
    max-width: 36ch;
  }

  /* The steps are a real sequence, so the numbers carry it: large mono numerals in peach. */
  .step {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.375rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-jupiter);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .process h3 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .process p {
    color: var(--color-text-muted);
  }

  /* The proof under each step: where it happened, as a link to that case study. */
  .process .evidence {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-text-subtle);
  }
  .process .evidence a {
    min-height: 0;
    font-weight: 650;
  }

  @media (min-width: 900px) {
    .process {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  .process-section,
  .about-section {
    position: relative;
    overflow: clip;
  }
  .process-container,
  .about {
    position: relative;
    z-index: 1;
  }

  .about-body {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    max-width: var(--measure);
  }

  .about-body p {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .about {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: var(--space-16);
    }
  }
</style>
