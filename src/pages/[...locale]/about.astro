---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HighlightedTitle from '../../components/HighlightedTitle.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import SkillTree from '../../components/SkillTree.astro';
import { getSkillTree } from '../../lib/content/skills';
import { site } from '../../data/site';
import { localeParams, resolveLocale, useTranslations } from '../../i18n';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const skills = await getSkillTree(locale);
---

<BaseLayout
  title={t('about.title')}
  description={t('about.description', {
    person: site.person,
    role: t('site.role').toLowerCase(),
    focus: t('site.focus').toLowerCase(),
  })}
>
  <section class="section">
    <div class="container">
      <SectionHeading path="about" id="page-title" level="h1">
        <HighlightedTitle text={t('about.heading')} word={t('about.headingWord')} />
      </SectionHeading>

      <div class="prose">
        <p class="lead">{t('about.lead', { person: site.person })}</p>
        <p>{t('about.approach')}</p>
        <p>{t('about.background')}</p>
        <p>{t('about.today')}</p>
      </div>

      {skills && (
        <section class="work-with" aria-labelledby="work-with">
          <h2 id="work-with">{t('about.workWith')}</h2>
          <SkillTree tree={skills} />
        </section>
      )}
    </div>
  </section>
  <ContactCTA />
</BaseLayout>

<style>
  .prose {
    max-width: var(--measure);
  }
  .lead {
    font-size: var(--text-lead);
    color: var(--color-text);
  }
  p {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }
  strong {
    color: var(--color-text);
  }
  .work-with {
    margin-top: var(--space-16);
  }
  h2 {
    margin-bottom: var(--space-4);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
</style>
