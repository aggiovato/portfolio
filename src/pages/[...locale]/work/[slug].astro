---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectMeta from '../../../components/ProjectMeta.astro';
import ProjectGlance from '../../../components/ProjectGlance.astro';
import TechList from '../../../components/TechList.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import StarField from '../../../components/StarField.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import HorizonArc from '../../../components/HorizonArc.astro';
import ArticleBody from '../../../components/ArticleBody.astro';
import {
  getNextProject,
  getProjectAlternates,
  getProjectsInLocale,
  projectPath,
  type Project,
} from '../../../lib/content/projects';
import { defaultLocale, localizePath, locales, resolveLocale, useTranslations } from '../../../i18n';

// One route per case study and locale where it is written; untranslated ones have no page here
// (listings link to the default-locale original instead of duplicating its content).
export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    locales.map(async (locale) => {
      const projects = await getProjectsInLocale(locale);
      return projects.map((project) => ({
        params: { locale: locale === defaultLocale ? undefined : locale, slug: project.data.slug },
        props: { project, next: getNextProject(project, projects) },
      }));
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alternates = await getProjectAlternates(project);
const { Content, headings } = await render(project);
// Gallery and Stack (in page order) are rendered by the page, not by the Markdoc body, so add them by hand.
const toc = [
  ...headings.filter((h) => h.depth === 2),
  ...(data.gallery.length > 0 ? [{ depth: 2, slug: 'gallery', text: t('project.gallery') }] : []),
  ...(data.stack.length > 0 ? [{ depth: 2, slug: 'stack', text: t('project.stack') }] : []),
];
const links = [
  data.links.demo && { href: data.links.demo, label: t('project.liveDemo') },
  data.links.code && { href: data.links.code, label: t('project.sourceCode') },
  data.links.docs && { href: data.links.docs, label: t('project.documentation') },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
  ogImage={data.cover && { src: data.cover.src, alt: data.cover.alt }}
  article={{ publishedTime: data.publishedAt, modifiedTime: data.updatedAt, tags: data.categories }}
  jsonLd={{
    '@type': 'Article',
    headline: data.title,
    description: data.summary,
    datePublished: data.publishedAt?.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt)?.toISOString(),
    keywords: data.categories.join(', '),
  }}
  noindex={data.publicationStatus !== 'published'}
  alternates={alternates}
>
  <article>
    <!-- Header in the hero's sky (§3); the stars stay clear of the text and are hidden on phones. -->
    <div class="approach">
      <StarField count={90} seed={11} />
      <header class="container head">
        <div class="head-main">
          <p class="path-label">
            portfolio / <a href={localizePath('/work/', locale)}>work</a> / <b>{data.slug}.mdoc</b>
          </p>
          <h1 style={`view-transition-name: title-${data.slug}`}>{data.title}</h1>
          {data.tagline && <p class="lead">{data.tagline}</p>}
          <p class="summary">{data.summary}</p>
          {links.length > 0 && (
            <ul class="links">
              {links.map((l) => (
                <li>
                  <a class="link-underline external" href={l.href} rel="noopener" target="_blank">
                    {l.label}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M9 7h8v8"></path>
                    </svg>
                    <span class="visually-hidden">{t('a11y.newTab')}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="head-glance">
          <ProjectGlance glance={data.glance} />
        </div>
      </header>
    </div>

    <!--
      Same horizon and plum surface as the home's projects: the card's screenshot lands on the
      ground it left (view transition). Desktop: cover with the fact sheet beside it.
    -->
    <div class="landing section--projects">
      <HorizonArc />
      <div class:list={['container', 'intro', data.cover && 'has-cover']}>
        {data.cover && (
          <figure class="cover">
            <Image
              style={`view-transition-name: cover-${data.slug}`}
              src={data.cover.src}
              alt={data.cover.alt}
              widths={[640, 1024, 1440, 1920, 2560]}
              sizes="(min-width: 1360px) 920px, (min-width: 1024px) 66vw, 94vw"
              loading="eager"
              fetchpriority="high"
            />
            {(data.cover.caption || data.links.demo) && (
              <figcaption>
                {data.cover.caption}
                {data.links.demo && (
                  <>
                    {data.cover.caption && ' '}
                    <a href={data.links.demo} rel="noopener" target="_blank">
                      {t('project.tryItLive')}
                      <span class="visually-hidden">{t('a11y.newTab')}</span>
                    </a>
                  </>
                )}
              </figcaption>
            )}
          </figure>
        )}

        <ProjectMeta data={data} />
      </div>
    </div>

    <ArticleBody toc={toc}>
      <Content />
    </ArticleBody>

    {data.gallery.length > 0 && (
      <section class="container gallery-band" aria-labelledby="gallery">
        <h2 id="gallery">{t('project.gallery')}</h2>
        <ProjectGallery images={data.gallery} />
      </section>
    )}

    <!-- Reference material closes the article: the screenshots come right after the story. -->
    {data.stack.length > 0 && (
      <section class="container band band--column" aria-labelledby="stack">
        <h2 id="stack">{t('project.stack')}</h2>
        <TechList stack={data.stack} />
      </section>
    )}

    {next && (
      <nav class="container next" aria-label={t('project.next')}>
        <p class="path-label">{t('project.next')}</p>
        <a href={projectPath(next)}>
          <span class="next-title">
            {next.data.title}
            <svg
              class="next-arrow"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
          <span class="next-summary">{next.data.summary}</span>
        </a>
      </nav>
    )}
  </article>

  <ContactCTA />
</BaseLayout>

<style>
  .approach {
    position: relative;
    isolation: isolate;
  }
  /* Stars only on the right, fading towards the title and the horizon (room for the planet's limb). */
  .approach :global(.starfield) {
    z-index: -1;
    mask-image:
      linear-gradient(to right, transparent 25%, black 65%), linear-gradient(to top, transparent, black 40%);
    mask-composite: intersect;
  }
  @media (max-width: 767px) {
    .approach :global(.starfield) {
      display: none;
    }
  }
  .head {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }
  /* The path's one link: a quiet underline so it reads as a link, lavender on hover. */
  .head .path-label a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-control-border);
    text-underline-offset: 3px;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }
  .head .path-label a:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
  }
  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-h1-project);
    max-width: 18ch;
    /* Box fitted to the text: the card → case study transition does not distort the title. */
    width: fit-content;
  }
  /* Short lead (tagline) with the summary below it, less prominent. */
  .lead {
    margin-top: var(--space-4);
    max-width: 30ch;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
  }
  .summary {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--color-text-muted);
  }
  /* ↗ marks a link that leaves the site in a new tab (the text is announced, see a11y.newTab). */
  .external {
    gap: var(--space-1);
  }
  .external svg {
    color: var(--color-text-subtle);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .head {
    /* Room for the horizon, which rises --horizon-depth into the header. */
    padding-bottom: calc(var(--space-12) + var(--horizon-depth));
  }
  /*
   * First screen = the log entry: title and summary on the left, the one-minute layer (problem,
   * part, outcome) in the header's right half on desktop, above the horizon. On phones it follows
   * the links, before the cover. PRODUCT.md: understood without reading the whole article.
   */
  .head {
    display: grid;
    gap: var(--space-12);
  }
  .head-glance {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-16);
      align-items: start;
    }
    .head-glance {
      padding: var(--space-2) 0 0 var(--space-12);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }
  .landing {
    padding-block: var(--space-8);
  }
  @media (min-width: 1024px) {
    .landing {
      padding-bottom: var(--space-16);
    }
  }
  .cover :global(img) {
    width: 100%;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-card-border);
  }
  /* Makes clear it is a screenshot (not a widget) and links to the real demo. */
  .cover figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }
  /* Larger touch area through padding (does not change the caption line height). */
  .cover figcaption a {
    padding-block: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .intro {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 1024px) {
    .intro.has-cover {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .next {
    padding-bottom: var(--space-16);
  }
  .next a {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .next a:hover {
    border-color: var(--color-accent);
  }
  .next-title {
    font-size: var(--text-h3);
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .next-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .next-arrow {
    color: var(--color-accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .next a:hover .next-arrow {
    transform: translateX(4px);
  }
  .next-summary {
    color: var(--color-text-muted);
  }

  .gallery-band,
  .band {
    padding-bottom: var(--space-24);
  }
  .gallery-band h2,
  .band h2 {
    margin-bottom: var(--space-8);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  /* Desktop: band headings (and Stack) start on the reading column's edge, past the index. */
  @media (min-width: 1024px) {
    /* The gallery spans the container (the system starts at its edge); Stack follows the text. */
    .band--column {
      padding-left: calc(var(--gutter) + 14rem + var(--space-16));
    }
    .band--column > :global(*) {
      max-width: var(--measure);
    }
  }
</style>
