---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Watermark from '../../../components/Watermark.astro';
import ArticleBody from '../../../components/ArticleBody.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { getNoteAlternates, getNotesInLocale, notePath, type Note } from '../../../lib/content/notes';
import { readingMinutes } from '../../../lib/content/note-utils';
import { defaultLocale, localizePath, locales, resolveLocale, useTranslations } from '../../../i18n';

// One route per note and locale where it is written; untranslated notes have no page here.
export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    locales.map(async (locale) => {
      const notes = await getNotesInLocale(locale);
      return notes.map((note, i) => ({
        params: { locale: locale === defaultLocale ? undefined : locale, slug: note.data.slug },
        // Notes are sorted newest first: the next one to read is the previous, older note.
        props: { note, older: notes[i + 1] },
      }));
    }),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

interface Props {
  note: Note;
  older?: Note;
}

const { note, older } = Astro.props;
const { data } = note;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alternates = await getNoteAlternates(note);
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(date);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
  ogImage={data.cover && { src: data.cover.src, alt: data.cover.alt }}
  article={{ publishedTime: data.publishedAt, modifiedTime: data.updatedAt, tags: data.tags }}
  jsonLd={{
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.summary,
    datePublished: data.publishedAt?.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt)?.toISOString(),
    keywords: data.tags.join(', '),
  }}
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
  noindex={data.publicationStatus !== 'published'}
  alternates={alternates}
>
  <article>
    <div class="has-watermark">
      <Watermark kind="marbles" side="right" anchor="top" />
      <header class="container head">
        <p class="path-label">
          portfolio / <a href={localizePath('/notes/', locale)}>notes</a> / <b>{data.slug}.mdoc</b>
        </p>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
        <p class="meta">
          {data.publishedAt && (
            <time datetime={isoDate(data.publishedAt)}>
              {t('note.published', { date: formatDate(data.publishedAt) })}
            </time>
          )}
          {data.updatedAt && (
            <time datetime={isoDate(data.updatedAt)}>
              {t('note.updated', { date: formatDate(data.updatedAt) })}
            </time>
          )}
          <span>{t('note.readingTime', { minutes: String(readingMinutes(note.body ?? '')) })}</span>
        </p>
        {data.tags.length > 0 && (
          <ul class="chip-list" aria-label={t('note.tags')}>
            {data.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )}
      </header>
    </div>

    {data.cover && (
      <figure class="container cover">
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 40rem, 92vw"
          loading="eager"
          fetchpriority="high"
        />
        {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
      </figure>
    )}

    <ArticleBody toc={toc}>
      <Content />
    </ArticleBody>

    <!-- The reader just finished: the moment to offer the next note. -->
    <div class="container subscribe">
      <NewsletterForm id="note-newsletter" />
    </div>

    <nav class="container next" aria-label={t('note.all')}>
      {older && (
        <a class="older" href={notePath(older)}>
          <span class="older-title">{older.data.title}</span>
          <span class="older-summary">{older.data.summary}</span>
        </a>
      )}
      <a class="link-underline" href={localizePath('/notes/', locale)}>
        {t('note.all')}
      </a>
    </nav>
  </article>

  <ContactCTA />
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-16) var(--space-8);
  }
  .cover {
    margin-block: 0 var(--space-4);
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    max-width: var(--measure);
    height: auto;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
  }
  .cover figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }
  /*
   * Desktop: header, cover and closing links start on the reading column's edge (past the index in
   * ArticleBody), so the title, the picture and the text share one left line.
   */
  .subscribe {
    padding-bottom: var(--space-16);
  }
  @media (min-width: 1024px) {
    .head,
    .cover,
    .subscribe,
    .next {
      /* The container's own gutter, plus the index column and its gap in ArticleBody. */
      padding-left: calc(var(--gutter) + 14rem + var(--space-16));
    }
  }
  .head .path-label a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-control-border);
    text-underline-offset: 3px;
  }
  .head .path-label a:hover {
    text-decoration-color: var(--color-accent);
  }
  h1 {
    max-width: 22ch;
    font-size: var(--text-h1-project);
    text-wrap: balance;
  }
  .summary {
    max-width: var(--measure);
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }
  .next {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-24);
  }
  .older {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }
  .older-title {
    font-size: 1.375rem;
    font-weight: 650;
  }
  .older:hover .older-title {
    color: var(--color-accent);
  }
  .older-summary {
    color: var(--color-text-muted);
  }
</style>
