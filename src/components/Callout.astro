---
import { resolveLocale, useTranslations } from '../i18n';

/** Markdoc `{% callout %}` tag: constraints, learnings or editorial notes inside a case study. */
interface Props {
  type?: 'note' | 'constraint' | 'learning' | 'editorial';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));
const defaultTitle = t(`callout.${type}`);
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout-title">{title ?? defaultTitle}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  /*
   * A bordered aside with a tone dot before its title (same convention as the fact sheet's status
   * dot), not a coloured side stripe. Never lavender: a callout is not an action.
   */
  .callout {
    --tone: var(--color-text-subtle);
    margin-block: var(--space-8);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }
  .callout--constraint {
    --tone: var(--color-jupiter);
  }
  .callout--learning {
    --tone: var(--color-success);
  }
  .callout--editorial {
    --tone: var(--color-error);
  }
  .callout-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }
  .callout-title::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone);
  }
  .callout-body {
    color: var(--color-text-muted);
  }
  .callout-body :global(p + p) {
    margin-top: var(--space-2);
  }
</style>
