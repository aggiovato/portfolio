---
/**
 * A large, faint line drawing behind a section, as a watermark: part of the section's idea, never
 * content. Drawn with the rocket's dotted trail and thin strokes (DESIGN.md «The Landing Log»),
 * rotated, clipped by the section, decorative (aria-hidden) and static.
 * Each drawing is its own component in ./watermarks/ (what it shows and where it is used is in its
 * header); this one draws the shared grid, places the drawing and styles its strokes: `line`,
 * `accent` (the one lavender piece), `trail` (dotted) and `calc` (mono notes).
 * `anchor="top"` pins it beside a page's title instead of the section's middle.
 * The parent section must be `position: relative` with `overflow: hidden` (or `clip`).
 */
import Launch from './watermarks/Launch.astro';
import Liftoff from './watermarks/Liftoff.astro';
import Marbles from './watermarks/Marbles.astro';
import Orbits from './watermarks/Orbits.astro';
import Signal from './watermarks/Signal.astro';
import Structure from './watermarks/Structure.astro';

const drawings = {
  launch: Launch,
  structure: Structure,
  liftoff: Liftoff,
  orbits: Orbits,
  marbles: Marbles,
  signal: Signal,
};

interface Props {
  kind: keyof typeof drawings;
  side: 'left' | 'right' | 'center';
  anchor?: 'middle' | 'top';
}

const { kind, side, anchor = 'middle' } = Astro.props;
const Drawing = drawings[kind];
const grid = Array.from({ length: 6 }, (_, i) => `M${40 + i * 88} 20v480M20 ${40 + i * 88}h480`);
---

<div class:list={['watermark', `watermark--${side}`, `watermark--${anchor}`]} aria-hidden="true">
  <svg viewBox="0 0 520 520" fill="none">
    <g class="grid">
      {grid.map((d) => (
        <path d={d} />
      ))}
    </g>
    <Drawing />
  </svg>
</div>

<style>
  .watermark {
    position: absolute;
    z-index: 0;
    top: 50%;
    width: clamp(22rem, 38vw, 34rem);
    aspect-ratio: 1;
    pointer-events: none;
    color: var(--color-text);
    opacity: 0.07;
  }
  /* Half out of the page on its side, tilted towards the content. */
  .watermark--left {
    left: clamp(-8rem, -6vw, -3rem);
    transform: translateY(-50%) rotate(-12deg);
  }
  .watermark--right {
    right: clamp(-8rem, -6vw, -3rem);
    transform: translateY(-50%) rotate(10deg);
  }
  /* Beside a page's title: the drawing fills the empty side of the page head. */
  .watermark--top {
    top: clamp(-2rem, -2vw, 0rem);
  }
  .watermark--top.watermark--left {
    transform: rotate(-12deg);
  }
  .watermark--top.watermark--right {
    transform: rotate(10deg);
  }
  /* Centred behind the content, barely tilted: the launch sits under the three steps. */
  .watermark--center {
    left: 50%;
    transform: translate(-50%, -50%) rotate(-6deg);
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid {
    stroke: currentColor;
    stroke-width: 0.5;
    opacity: 0.6;
  }
  .watermark :global(.line),
  .watermark :global(.accent) {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The one lavender piece of each drawing: the rocket, the product. */
  .watermark :global(.accent) {
    stroke: var(--color-accent);
    stroke-width: 2.2;
  }
  .watermark :global(.trail) {
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 9;
  }
  .watermark :global(.calc) {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 15px;
  }
  /* Phones: the drawing would sit under the text; keep it only where there is room beside it. */
  @media (max-width: 767px) {
    .watermark {
      opacity: 0.045;
      width: 20rem;
    }
  }
  @media (forced-colors: active) {
    .watermark {
      display: none;
    }
  }
</style>
