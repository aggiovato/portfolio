---
import Lockup from './Lockup.astro';
import NewsletterForm from './NewsletterForm.astro';
import { site, type NavItem } from '../data/site';
import { localizePath, resolveLocale, useTranslations } from '../i18n';

interface Props {
  /** Menu entries, already filtered to the sections that have content (BaseLayout). */
  nav: readonly NavItem[];
  /** False on pages that already end with their own subscription form (notes). */
  subscribe?: boolean;
}

const { nav, subscribe = true } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="sign">
      <Lockup height={23} />
      <p class="visually-hidden">{site.brand}</p>
    </div>

    <nav aria-label={t('footer.label')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={localizePath(item.href, locale)}>{t(item.label)}</a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={site.links.github} rel="me noopener" target="_blank">
            GitHub
          </a>
        </li>
        {site.links.linkedin && (
          <li>
            <a href={site.links.linkedin} rel="me noopener" target="_blank">
              LinkedIn
            </a>
          </li>
        )}
      </ul>
    </nav>

    {subscribe && (
      <div class="subscribe">
        <NewsletterForm id="footer-newsletter" variant="compact" />
      </div>
    )}

    <p class="legal">
      © {year} {site.person}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12) max(var(--space-8), env(safe-area-inset-bottom));
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .inner {
    display: grid;
    gap: var(--space-8);
  }

  .sign {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .sign :global(.lockup) {
    flex-shrink: 0;
  }

  .subscribe {
    max-width: 40rem;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .legal {
    color: var(--color-text-subtle);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }

  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .legal,
    .subscribe {
      grid-column: 1 / -1;
    }
  }

  /* Phones: the back-to-top button sits over the last line; keep the copyright clear of it
     (button 52 px + its 16 px margin) instead of hiding the button where it is most useful. */
  @media (max-width: 767px) {
    .legal {
      padding-inline-end: 4.5rem;
    }
  }
</style>
