---
/**
 * Newsletter subscription (Brevo, double opt-in). A plain HTML form posted straight to the Brevo
 * form of a language (src/data/site.ts `newsletter`); Brevo redirects to /newsletter/pending/ and,
 * once the email link is clicked, to /newsletter/confirmed/. Works without JavaScript in the page's
 * language; with JS a language choice (EN · ES · IT) appears and retargets the form to that
 * language's list.
 *
 * - `full`: heading, text and form (end of a note).
 * - `compact`: one line and the form (footer).
 * `id` keeps labels unique when both appear on one page.
 */
import { newsletter } from '../data/site';
import { localeNames, locales, resolveLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  id: string;
  variant?: 'full' | 'compact';
}

const { id, variant = 'full' } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const available = locales.filter((l): l is Locale => Boolean(newsletter[l]));
// The page's language when it has a list, else the first one that does (English).
const initial = newsletter[locale] ? locale : available[0];
const action = initial ? newsletter[initial] : undefined;
const targets = Object.fromEntries(available.map((l) => [l, newsletter[l]]));
---

{action && initial && (
  <section class:list={['newsletter', `newsletter--${variant}`]} aria-labelledby={`${id}-title`}>
    {variant === 'full' ? (
      <>
        <h2 id={`${id}-title`}>{t('newsletter.title')}</h2>
        <p class="text">{t('newsletter.text')}</p>
      </>
    ) : (
      <h2 id={`${id}-title`} class="compact-title">
        {t('newsletter.footer')}
      </h2>
    )}
    <form method="post" action={action} data-newsletter={JSON.stringify(targets)}>
      <div class="row">
        <label class="field">
          <span class="label">{t('newsletter.email')}</span>
          <input
            type="email"
            name="EMAIL"
            required
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
          />
        </label>
        {/*
          Language as a segmented radio group (three options need no drop-down, and native option
          lists cannot be styled). The radios are the `locale` field Brevo reads; without JS the
          group stays hidden but the checked radio (the page's language) is still submitted.
        */}
        <fieldset class="field field--lang" hidden data-newsletter-lang>
          <legend class="label">{t('newsletter.language')}</legend>
          <div class="segments">
            {available.map((l) => (
              <label class="segment" title={localeNames[l]}>
                <input type="radio" name="locale" value={l} checked={l === initial} />
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="visually-hidden" lang={l}>
                  {l.toUpperCase()} {localeNames[l]}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <button class="btn btn-primary" type="submit">
          {t('newsletter.submit')}
        </button>
      </div>
      <p class="consent">{t('newsletter.consent')}</p>
      <!-- Brevo's anti-spam trap: people never see it, bots fill it in. -->
      <div class="trap" aria-hidden="true">
        <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="html_type" value="simple" />
    </form>
  </section>
)}

<script>
  // Progressive enhancement: show the language choice and point the form at that language's list.
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const targets = JSON.parse(form.dataset.newsletter ?? '{}') as Record<string, string>;
    const group = form.querySelector<HTMLFieldSetElement>('[data-newsletter-lang]');
    if (!group || Object.keys(targets).length < 2) return;
    group.hidden = false;
    group.addEventListener('change', (event) => {
      const target = targets[(event.target as HTMLInputElement).value];
      if (target) form.action = target;
    });
  });
</script>

<style>
  .newsletter {
    display: grid;
    gap: var(--space-3);
  }
  /* Same width as the reading column it closes (ArticleBody's grid track is var(--measure)). */
  .newsletter--full {
    box-sizing: border-box;
    max-width: var(--measure);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  h2 {
    font-size: var(--text-h3);
  }
  .compact-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--color-text);
  }
  .text {
    color: var(--color-text-muted);
  }
  form {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }
  .field {
    display: grid;
    gap: var(--space-1);
    flex: 1 1 14rem;
  }
  .field--lang {
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .field[hidden] {
    display: none;
  }
  .field--lang legend {
    padding: 0;
    margin-bottom: var(--space-1);
  }
  /* Segmented control: one outlined pill, the chosen language raised and outlined in lavender. */
  .segments {
    display: flex;
    min-height: 48px;
    padding: 3px;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    background: var(--color-bg);
  }
  .segment {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 1px solid transparent;
    border-radius: calc(var(--radius-control) - 4px);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .segment:hover {
    color: var(--color-text);
  }
  .segment input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segment:has(input:checked) {
    background: var(--color-surface-raised);
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .segment:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }
  input[type='email'] {
    min-height: 48px;
    width: 100%;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  input[type='email']:hover {
    border-color: var(--color-text-muted);
  }
  input:user-invalid {
    border-color: var(--color-error);
  }
  /* .btn is styled for links; a <button> also needs the font and no native border. */
  .btn {
    flex: 0 0 auto;
    border: 0;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .consent {
    font-size: var(--text-meta);
    line-height: 1.5;
    color: var(--color-text-subtle);
  }
  /* Off-screen, not display:none: some bots skip hidden fields, which is what the trap relies on. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
