---
import { site } from '../data/site';
import { localizePath, resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="section contact-cta" aria-labelledby="cta-title">
  <div class="container inner">
    <h2 id="cta-title">{t('cta.title')}</h2>
    <div class="actions">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>
        {t('cta.email')}
      </a>
      <a class="link-underline" href={localizePath('/contact/', locale)}>
        {t('cta.otherWays')}
      </a>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: var(--space-8);
  }
  h2 {
    font-size: var(--text-h2);
    max-width: 18ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
