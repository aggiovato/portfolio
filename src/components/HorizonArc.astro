---
/**
 * Horizon between the hero and the projects section (decorative, aria-hidden).
 *
 * A single fine, dotted arc — the same trail the hero's rocket leaves — marks the chapter break.
 * No fills and no blur: the page ground is continuous, so there is no edge to blend and nothing
 * to show a seam. The section below changes tone over a long distance instead (.section--projects).
 * Place it as the first child of a section with position: relative.
 */
const ARC = 'M0 100 Q 720 -100 1440 100';
---

<div class="horizon" aria-hidden="true">
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none" focusable="false">
    <path d={ARC}></path>
  </svg>
</div>

<style>
  .horizon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--horizon-depth);
    transform: translateY(-100%);
    pointer-events: none;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Same dots as the rocket's trail (tokens). non-scaling-stroke keeps them round and evenly spaced
     although the viewBox is stretched. */
  path {
    fill: none;
    stroke: var(--trail-dot-color);
    stroke-width: var(--trail-dot-size);
    stroke-linecap: round;
    stroke-dasharray: 1 var(--trail-dot-gap);
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 2px rgb(21 22 30 / 0.9));
  }
</style>
