---
/**
 * The hero's night sky carried to the top of every other page (Work, Notes, a note, About,
 * Contact, 404…), so all screens share one world: stars on the right half fading towards the text
 * and downwards, over a faint plum glow. Decorative; the home and case studies draw their own.
 * Rendered by BaseLayout at the top of <main> (behind the first section).
 */
import StarField from './StarField.astro';
---

<div class="page-sky" aria-hidden="true">
  <StarField count={80} seed={23} />
</div>

<style>
  .page-sky {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: min(38rem, 90vh);
    pointer-events: none;
    /* The upper atmosphere's plum, as a glow from the top right, never a band (Gradual Atmosphere). */
    background: radial-gradient(60% 70% at 85% 0%, rgb(33 27 46 / 0.9), transparent 70%);
  }
  .page-sky :global(.starfield) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image:
      linear-gradient(to right, transparent 30%, black 75%), linear-gradient(to top, transparent, black 55%);
    mask-composite: intersect;
  }
  @media (max-width: 767px) {
    .page-sky :global(.starfield) {
      mask-image: linear-gradient(to top, transparent, black 60%);
      opacity: 0.6;
    }
  }
</style>
