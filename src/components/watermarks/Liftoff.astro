---
/** Watermark drawing (Watermark.astro draws the grid, places and styles it): The rocket leaving its pad, with the tower and the countdown. How I work. */
import { MARK } from '../../lib/brand/mark';
---

{/* The pad and the launch tower with its arms. */}
<path class="line" d="M150 440h220M175 440l20-26h130l20 26" />
<path class="line" d="M340 414V170M372 414V170M340 200h32M340 250h32M340 300h32M340 350h32" />
<path class="line" d="M340 230h-48M340 320h-48" />
{/* The rocket (the brand mark, outlined), just off the pad with its flames on, in lavender. */}
<g class="accent" transform={`translate(260 250) scale(1.5) translate(-${MARK.centre.x} -${MARK.centre.y})`}>
  <path d={MARK.body} vector-effect="non-scaling-stroke" />
  <path d={MARK.bar} vector-effect="non-scaling-stroke" />
  <path d={MARK.flames} vector-effect="non-scaling-stroke" />
</g>
{/* Exhaust: the trail's dots spreading below each nozzle's flame. */}
<path class="trail" d="M206 362l-14 56M214 364l2 58M312 364l14 56M304 362l-2 58" />
{/* The ascent it will follow. */}
<path class="trail" d="M260 150V40" />
<path class="line" d="M252 52l8-14 8 14" />
<g class="calc">
  <text x="90" y="200">
    T−3
  </text>
  <text x="90" y="236">
    T−2
  </text>
  <text x="90" y="272">
    T−1
  </text>
  <text x="90" y="318">
    ignition
  </text>
  <text x="388" y="480">
    pad 01
  </text>
</g>
