---
/**
 * «What I work with» as a tree (About page): areas → technologies → branches, each branch with when
 * it is used. Native <details>, so it opens with a click, Enter or Space and works without JS.
 * Drawn with the rocket's dotted trail (DESIGN.md «The Landing Log»): technologies hang from a
 * trunk, an open one fills its diamond in lavender, like the section being read in ArticleBody.
 */
import type { SkillTree } from '../lib/content/skill-utils';

interface Props {
  tree: SkillTree;
}

const { tree } = Astro.props;
---

<div class="skill-tree">
  <p class="intro">{tree.intro}</p>
  <div class="groups">
    {tree.groups.map((group) => (
      <section class="group" aria-labelledby={`skills-${group.id}`}>
        <h3 id={`skills-${group.id}`} class="group-title">
          {group.title}
        </h3>
        <ul class="nodes">
          {group.nodes.map((node) => (
            <li>
              <details class="node">
                <summary>
                  <span class="node-name">{node.name}</span>
                  <span class="node-summary">{node.summary}</span>
                </summary>
                <dl class="branches">
                  {node.branches.map((branch) => (
                    <div class="branch">
                      <dt>{branch.name}</dt>
                      <dd>{branch.when}</dd>
                    </div>
                  ))}
                </dl>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>

<style>
  .intro {
    margin-bottom: var(--space-8);
    color: var(--color-text-muted);
  }
  .groups {
    display: grid;
    gap: var(--space-8) var(--space-16);
    align-items: start;
  }
  @media (min-width: 900px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .group-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  /* The trunk: a dotted line the technologies hang from. */
  .nodes,
  .branches {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--space-6);
    list-style: none;
  }
  .nodes::before,
  .branches::before {
    content: '';
    position: absolute;
    inset-block: var(--space-3);
    left: 2.5px;
    width: 3px;
    background-image: radial-gradient(circle, var(--trail-dot-color) 1.1px, transparent 1.5px);
    background-size: 3px calc(1px + var(--trail-dot-gap));
  }

  summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-4);
    min-height: 44px;
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* The node on the trunk: an outlined diamond, filled in lavender while open. */
  summary::before {
    content: '';
    position: absolute;
    top: calc(var(--space-3) + 0.55em);
    left: calc(-1 * var(--space-6) + 0.5px);
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--color-text-subtle);
    background: var(--color-bg);
    transform: rotate(45deg);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .node[open] > summary::before {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  /* Disclosure chevron, as in the article index on phones: says it opens, turns when it does. */
  summary::after {
    content: '';
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    width: 8px;
    height: 8px;
    margin-right: var(--space-1);
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .node[open] > summary::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .node-name {
    grid-column: 1;
    font-weight: 650;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .node-summary {
    grid-column: 1;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  /* Only on real hover: on touch screens the colour would stick after a tap. */
  @media (hover: hover) {
    summary:hover .node-name {
      color: var(--color-accent);
    }
  }

  /* Branches: a second, indented trail under the open technology. */
  .branches {
    margin: var(--space-1) 0 var(--space-4);
  }
  .branch {
    position: relative;
    padding-block: var(--space-2);
  }
  dt {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }
  dd {
    margin: var(--space-1) 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
