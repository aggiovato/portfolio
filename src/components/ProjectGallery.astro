---
/**
 * Case study gallery as a «system map» (spec §10, §15, §19 «orbital map: experimental, offer an
 * equivalent list»; DESIGN.md «Orbital Gallery»).
 *
 * - Baseline (phones, no JS, reduced motion): a grid of real images with their captions, each a
 *   link to the full-resolution image (the viewer opens it when JS is on).
 * - Orbit mode (JS, ≥768px, motion allowed): Jupiter at the centre and one small moon per image
 *   on one or two tilted rings drawn with the rocket's dotted trail. A moon is a sphere textured
 *   with its own image, blurred: it carries the screen's colours, not its unreadable UI. Back moons
 *   pass behind the planet. The selected moon wears a lavender ring and a dotted trail links it to
 *   the preview, where the image is shown whole. The selection changes only when the visitor
 *   chooses (a moon, or a caption in the list); the orbit keeps turning slowly and pauses with its
 *   toggle, under the pointer and off-screen (WCAG 2.2.2). Dragging a moon bends its ring and a
 *   spring brings it back (src/scripts/gallery/system.ts; maths in src/lib/gallery/).
 * - The caption list is the accessible selector; the preview opens the <dialog> viewer: zoom
 *   (wheel, pinch, buttons, double-click), pan, 90° rotation, previous/next. Keys: ← → + − R 0.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import jupiter from '../assets/hero/jupiter.png';
import { resolveLocale, useTranslations } from '../i18n';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { images } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));
const total = String(images.length);
const variants = await Promise.all(
  images.map(async (g) => ({
    // Viewer and no-JS link target.
    full: await getImage({ src: g.src, width: Math.min(g.src.width, 2560), format: 'webp' }),
    // Preview beside the orbit.
    preview: await getImage({ src: g.src, width: Math.min(g.src.width, 1280), format: 'webp' }),
    // Moon surface: tiny on purpose, it is blurred anyway.
    texture: await getImage({ src: g.src, width: 96, format: 'webp' }),
  })),
);
const items = images.map((g, i) => {
  const n = String(i + 1);
  const caption = g.caption ?? g.alt;
  return {
    ...g,
    caption,
    ...variants[i],
    openLabel: t('gallery.open', { n, total, caption }),
    showLabel: t('gallery.show', { n, total, caption }),
  };
});
---

<div class="gallery" data-gallery>
  <div class="system-layout">
    <!-- Orbit mode only (the script unhides it). Purely visual: the caption list is the selector. -->
    <div class="system" data-system hidden>
      <div class="stage" data-stage>
        <svg class="rings rings-back" aria-hidden="true" data-rings-back></svg>
        <div class="planet" aria-hidden="true">
          <Image src={jupiter} alt="" width={480} loading="lazy" />
        </div>
        <svg class="rings rings-front" aria-hidden="true" data-rings-front></svg>
        <div class="moons" aria-hidden="true">
          {items.map((g) => (
            <span class="moon" data-moon style={`--tex: url("${g.texture.src}")`}>
              <span class="moon-surface" />
            </span>
          ))}
        </div>
      </div>
      <button
        class="orbit-toggle"
        type="button"
        aria-pressed="false"
        aria-label={t('gallery.pause')}
        title={t('gallery.pause')}
        data-orbit-toggle
      >
        <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"></path>
        </svg>
        <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor"></path>
        </svg>
      </button>
    </div>

    <div class="side">
      <!-- Orbit mode only: the selected image, whole. Opens the viewer. -->
      <figure class="preview" data-preview hidden>
        <button class="preview-open" type="button" data-preview-open>
          <img alt="" data-preview-img />
        </button>
        <figcaption data-preview-caption></figcaption>
      </figure>

      <ul class="shots" role="list" data-shots>
        {items.map((g) => (
          <li class:list={['shot', g.src.height > g.src.width && 'is-portrait']}>
            <a
              href={g.full.src}
              data-full={g.full.src}
              data-preview-src={g.preview.src}
              data-caption={g.caption}
              data-open-label={g.openLabel}
              data-show-label={g.showLabel}
              aria-label={g.openLabel}
            >
              <Image
                src={g.src}
                alt={g.alt}
                widths={[320, 480, 720]}
                sizes="(min-width: 768px) 30vw, 92vw"
                loading="lazy"
              />
              <span class="shot-caption">{g.caption}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Orbit mode, wide screens: the dotted trail from the selected moon to the preview. -->
  <svg class="landing-trail" aria-hidden="true" data-landing-trail>
    <path></path>
  </svg>

  <dialog class="viewer" aria-label={t('viewer.label')} data-viewer>
    <div class="viewer-canvas" data-canvas>
      <img data-viewer-img alt="" draggable="false" />
    </div>
    <div class="viewer-bar">
      <p class="viewer-caption">
        <span class="viewer-count" data-counter></span> <span data-caption></span>
      </p>
      <div class="viewer-tools">
        <button type="button" data-act="prev" aria-label={t('viewer.previous')} title={t('viewer.previous')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 6l-6 6 6 6"></path>
          </svg>
        </button>
        <button type="button" data-act="next" aria-label={t('viewer.next')} title={t('viewer.next')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6"></path>
          </svg>
        </button>
        <span class="sep" aria-hidden="true"></span>
        <button
          type="button"
          data-act="zoom-out"
          aria-label={t('viewer.zoomOut')}
          title={t('viewer.zoomOut')}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="M8 11h6M20 20l-4.5-4.5"></path>
          </svg>
        </button>
        <button type="button" data-act="zoom-in" aria-label={t('viewer.zoomIn')} title={t('viewer.zoomIn')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="M8 11h6M11 8v6M20 20l-4.5-4.5"></path>
          </svg>
        </button>
        <button type="button" data-act="rotate" aria-label={t('viewer.rotate')} title={t('viewer.rotate')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5"></path>
          </svg>
        </button>
        <button type="button" data-act="reset" aria-label={t('viewer.reset')} title={t('viewer.reset')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9V4h5M20 15v5h-5M4 15v5h5M20 9V4h-5"></path>
          </svg>
        </button>
        <span class="sep" aria-hidden="true"></span>
        <button type="button" data-act="close" aria-label={t('viewer.close')} title={t('viewer.close')}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <!-- Visible on desktop (keys and wheel); phones rely on familiar gestures. -->
      <p class="viewer-hint">{t('viewer.hint')}</p>
    </div>
  </dialog>
</div>

<script>
  // System map, caption list and viewer (src/scripts/gallery/); maths in src/lib/gallery/.
  import { initGalleries } from '../scripts/gallery';

  initGalleries();
</script>

<style>
  .gallery {
    position: relative;
  }

  /* ---------- Baseline: a grid of real images (phones, no JS, reduced motion) ---------- */
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-8) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .shot a {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-card-border);
    background: var(--color-surface);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* Phone screenshots: narrower columns (two on a phone), so one screen does not fill the viewport. */
  .shots:has(.is-portrait) {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: var(--space-6) var(--space-4);
  }

  /* Phone screenshots keep their portrait shape. */
  .shot.is-portrait :global(img) {
    aspect-ratio: auto;
    width: 100%;
  }

  .shot a:hover :global(img) {
    border-color: var(--color-accent);
  }

  .shot-caption {
    font-size: var(--text-meta);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .system,
  .preview,
  .landing-trail {
    display: none;
  }

  /* ---------- System map (orbit mode) ---------- */
  .is-orbit .system-layout {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .is-orbit .system-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-16);
      /* Top-aligned: the planet sits level with the preview, however long the caption list. */
      align-items: start;
    }
  }

  .is-orbit .system:not([hidden]) {
    position: relative;
    display: block;
  }

  .stage {
    position: relative;
    height: clamp(20rem, 32vw, 28rem);
    isolation: isolate;
    touch-action: pan-y;
  }

  /* The planet dominates: moons are a fraction of its size. */
  .planet {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    width: clamp(9rem, 15vw, 13rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
  }

  .planet :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    filter: saturate(0.86) brightness(0.9);
    /* Soft drop shadow towards the lower right, matching the sunlit side of the moons. */
    box-shadow: 10px 14px 40px -12px rgb(0 0 0 / 0.8);
  }

  .rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .rings-back {
    z-index: 1;
  }

  .rings-front {
    z-index: 4;
  }

  .rings :global(path) {
    fill: none;
    stroke: var(--trail-dot-color);
    stroke-width: var(--trail-dot-size);
    stroke-linecap: round;
    stroke-dasharray: 1 var(--trail-dot-gap);
  }

  .moons {
    position: absolute;
    inset: 0;
  }

  /*
   * A moon: a small sphere whose surface is its own image, blurred into colour, lit from the upper
   * left with a terminator to the lower right. No coloured halo; depth dims the back moons.
   */
  .moon {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(1.75rem, 2.6vw, 2.4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    cursor: pointer;
    touch-action: none;
    will-change: transform;
  }

  .moon-surface {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-surface-raised);
  }

  .moon-surface::before {
    content: '';
    position: absolute;
    inset: -20%;
    background: var(--tex) center / cover no-repeat;
    /* Dark screenshots would make black moons: lift them a little. */
    filter: blur(3px) saturate(1.25) brightness(1.5);
  }

  .moon-surface::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 32% 28%,
        color-mix(in srgb, var(--color-text) 28%, transparent),
        transparent 38%
      ),
      radial-gradient(circle at 70% 75%, rgb(8 9 13 / 0.78), transparent 66%),
      color-mix(in srgb, var(--color-bg) calc(var(--dim, 0) * 55%), transparent);
  }

  /* The selected moon: a fine lavender ring with a gap, like a target marker. */
  .moon::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .moon:hover::after {
    opacity: 0.45;
    transform: scale(1);
  }

  .moon.is-active::after {
    opacity: 1;
    transform: scale(1);
  }

  .moon.is-dragged {
    cursor: grabbing;
  }

  .orbit-toggle {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 6;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-control-border);
    border-radius: 50%;
    cursor: pointer;
  }

  .orbit-toggle:hover {
    color: var(--color-text);
  }

  .orbit-toggle .i-play,
  .orbit-toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .orbit-toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  /* Preview: the selected image, whole. */
  .is-orbit .preview:not([hidden]) {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }

  /* The button hugs the image, so the radius and border follow its real edges (no letterbox). */
  .preview-open {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-control);
    cursor: zoom-in;
  }

  .preview-open img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 24rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-card-border);
    opacity: 0;
    transition: opacity 280ms var(--ease-out);
  }

  .preview.is-in img {
    opacity: 1;
  }

  .preview figcaption {
    font-size: var(--text-meta);
    color: var(--color-text-muted);
  }

  /* In orbit mode the list is the selector: captions only, the selected one marked with ◆. */
  .is-orbit .shots {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .is-orbit .shot :global(img) {
    display: none;
  }

  .is-orbit .shot a {
    position: relative;
    display: block;
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .is-orbit .shot a:hover {
    color: var(--color-text);
  }

  .is-orbit .shot a[aria-current='true'] {
    color: var(--color-text);
  }

  .is-orbit .shot a[aria-current='true']::before {
    content: '';
    position: absolute;
    left: var(--space-1);
    top: calc(var(--space-2) + 0.6em);
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  .is-orbit .shot-caption {
    font-size: var(--text-meta);
    color: inherit;
  }

  /* The landing trail from the selected moon to the preview (side-by-side layout only). */
  .is-orbit .landing-trail {
    position: absolute;
    inset: 0;
    z-index: 7;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .landing-trail path {
    fill: none;
    stroke: var(--trail-dot-color);
    stroke-width: var(--trail-dot-size);
    stroke-linecap: round;
    stroke-dasharray: 1 var(--trail-dot-gap);
  }

  /* ---------- Viewer ---------- */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(13 14 20 / 0.98);
    color: var(--color-text);
    overflow: hidden;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .viewer::backdrop {
    background: transparent;
  }

  .viewer-canvas {
    display: grid;
    place-items: center;
    min-height: 0;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
  }

  .viewer-canvas.is-zoomed {
    cursor: grab;
  }

  .viewer-canvas img {
    max-width: min(96vw, 1600px);
    max-height: calc(100dvh - 7rem);
    border-radius: var(--radius-control);
    transition: transform var(--duration-fast) var(--ease-out);
    user-select: none;
  }

  .viewer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-3) max(var(--space-6), env(safe-area-inset-right))
      calc(var(--space-3) + env(safe-area-inset-bottom)) max(var(--space-6), env(safe-area-inset-left));
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
  }

  .viewer-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (min-width: 1024px) and (pointer: fine) {
    .viewer-hint {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      flex-basis: 100%;
      order: 3;
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      color: var(--color-text-subtle);
    }
  }

  .viewer-caption {
    font-size: var(--text-meta);
    color: var(--color-text-muted);
  }

  .viewer-count {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-right: var(--space-2);
  }

  .viewer-tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .viewer-tools button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    color: var(--color-text-muted);
    border: 0;
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .viewer-tools button:hover {
    color: var(--color-text);
    background: var(--color-surface-raised);
  }

  .viewer-tools svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sep {
    width: 1px;
    height: 24px;
    margin-inline: var(--space-2);
    background: var(--color-border);
  }
</style>
