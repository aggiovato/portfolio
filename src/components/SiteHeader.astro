---
import LogoMark from './LogoMark.astro';
import { nav, site } from '../data/site';
import {
  localeNames,
  localizePath,
  locales,
  resolveLocale,
  stripLocale,
  useTranslations,
  type Locale,
} from '../i18n';

interface Props {
  /** URL of the current page in each locale where it exists. */
  alternates: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
const isActive = (href: string) => current.startsWith(href);

// Keep the reader on the equivalent page; an untranslated case study falls back to that locale's work index.
const languages = locales
  .filter((l) => l !== locale)
  .map((l) => ({
    locale: l,
    name: localeNames[l],
    href: alternates[l] ?? localizePath(current.startsWith('/work/') ? '/work/' : '/', l),
  }));
---

<header class="site-header" style="view-transition-name: site-header">
  <div class="container bar">
    <a class="brand" href={localizePath('/', locale)} aria-label={t('nav.home', { brand: site.brand })}>
      <LogoMark size={44} class="brand-mark" />
      <span class="brand-word">{site.brand}</span>
    </a>

    <!-- Without JS the links are always shown. With JS on mobile they fold behind the button. -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="visually-hidden">{t('nav.menu')}</span>
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path class="l1" d="M4 8h16"></path>
        <path class="l2" d="M4 16h16"></path>
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.label')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={localizePath(item.href, locale)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {t(item.label)}
            </a>
          </li>
        ))}
        <li class="nav-github">
          <a href={site.links.github} rel="me noopener" target="_blank">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
            </svg>
            <span class="github-label">GitHub</span>
          </a>
        </li>
        {languages.map((l) => (
          <li class="nav-lang">
            <a
              href={l.href}
              hreflang={l.locale}
              lang={l.locale}
              aria-label={`${l.locale.toUpperCase()} — ${useTranslations(l.locale)('nav.switchTo', { language: l.name })}`}
              data-locale-switch={l.locale}
            >
              <span aria-hidden="true">{l.locale.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  const mq = window.matchMedia('(max-width: 767px)');

  if (toggle && navEl) {
    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.dataset.open = String(open);
      if (open) navEl.querySelector('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    const sync = () => {
      toggle.hidden = !mq.matches;
      navEl.dataset.collapsible = String(mq.matches);
      setOpen(false);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    mq.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    color: var(--color-accent);
  }

  .brand-word {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .nav ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text-muted);
    border-radius: var(--radius-control);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .nav-github {
    margin-left: var(--space-2);
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .nav-lang a {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
  }

  .github-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .menu-toggle[hidden] {
    display: none;
  }

  .menu-toggle path {
    transition: transform var(--duration-fast) var(--ease-out);
    transform-origin: center;
  }

  .menu-toggle[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile with JS: collapsible menu */
  .nav[data-collapsible='true'] {
    display: none;
    flex-basis: 100%;
    padding-bottom: var(--space-4);
  }

  .nav[data-collapsible='true'][data-open='true'] {
    display: block;
  }

  .nav[data-collapsible='true'] ul {
    flex-direction: column;
    align-items: stretch;
  }

  .nav[data-collapsible='true'] a {
    font-size: 1.25rem;
    padding-inline: 0;
  }

  .nav[data-collapsible='true'] .nav-github {
    margin: var(--space-2) 0 0;
    padding: var(--space-2) 0 0;
    border-left: 0;
    border-top: 1px solid var(--color-border);
  }

  .nav[data-collapsible='true'] .github-label {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
  }

  @media (max-width: 767px) {
    .brand-word {
      font-size: 1.3rem;
    }
  }
</style>
