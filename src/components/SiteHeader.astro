---
import LogoMark from './LogoMark.astro';
import { nav, site } from '../data/site';
import {
  localeNames,
  localizePath,
  locales,
  resolveLocale,
  stripLocale,
  useTranslations,
  type Locale,
} from '../i18n';

interface Props {
  /** URL of the current page in each locale where it exists. */
  alternates: Partial<Record<Locale, string>>;
}

const { alternates } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
const isActive = (href: string) => current.startsWith(href);

// Keep the reader on the equivalent page; an untranslated case study falls back to that locale's work index.
const languages = locales
  .filter((l) => l !== locale)
  .map((l) => ({
    locale: l,
    name: localeNames[l],
    href: alternates[l] ?? localizePath(current.startsWith('/work/') ? '/work/' : '/', l),
  }));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath('/', locale)} aria-label={t('nav.home', { brand: site.brand })}>
      <LogoMark size={44} class="brand-mark" />
      <span class="brand-word">{site.brand}</span>
    </a>

    <!--
      Without JS the links are always shown. With JS on mobile they fold behind the button and open
      as a panel over the content (CSS keys off the early `js` class, so there is no flash).
    -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">{t('nav.menu')}</span>
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path class="l1" d="M4 8h16"></path>
        <path class="l2" d="M4 16h16"></path>
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.label')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={localizePath(item.href, locale)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {t(item.label)}
            </a>
          </li>
        ))}
        <li class="nav-github">
          <a href={site.links.github} rel="me noopener" target="_blank">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
            </svg>
            <span class="github-label">GitHub</span>
          </a>
        </li>
        {languages.map((l) => (
          <li class="nav-lang">
            <a
              href={l.href}
              hreflang={l.locale}
              lang={l.locale}
              aria-label={`${l.locale.toUpperCase()} — ${useTranslations(l.locale)('nav.switchTo', { language: l.name })}`}
              data-locale-switch={l.locale}
            >
              <span aria-hidden="true">{l.locale.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  /**
   * Mobile menu: a panel over the content (§9). While open, the page behind is inert and does not
   * scroll, so focus stays in the header; Escape, the scrim, the toggle and leaving the mobile
   * breakpoint close it. It also closes before the page is captured for a view transition, so the
   * next page does not animate from an open menu.
   */
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  // Must match the max-width media query in the styles below.
  const mq = window.matchMedia('(max-width: 767px)');
  const behind = [document.querySelector('main'), document.querySelector('footer')];

  if (toggle && navEl) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, { focus = true } = {}) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.dataset.open = String(open);
      document.documentElement.dataset.menuOpen = String(open);
      behind.forEach((el) => el && (el.inert = open));
      if (!focus) return;
      if (open) navEl.querySelector('a')?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });
    // The scrim is the header's ::after, so a click on it targets the header itself.
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (isOpen() && !navEl.contains(target) && !toggle.contains(target)) setOpen(false);
    });
    mq.addEventListener('change', () => isOpen() && setOpen(false, { focus: false }));
    addEventListener('pageswap', () => isOpen() && setOpen(false, { focus: false }));
    // Back/forward cache restores the page as it was left.
    addEventListener('pageshow', (e) => e.persisted && isOpen() && setOpen(false, { focus: false }));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
  }

  /*
   * The blur lives on a pseudo-element: backdrop-filter on the header itself would make it the
   * containing block of the fixed mobile panel and a backdrop root, so the panel's own glass could
   * not blur the page behind it.
   */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    color: var(--color-accent);
  }

  .brand-word {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .nav ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text-muted);
    border-radius: var(--radius-control);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .nav-github {
    margin-left: var(--space-2);
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .nav-lang a {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
  }

  .github-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .menu-toggle path {
    transition: transform var(--duration-fast) var(--ease-out);
    transform-origin: center;
  }

  .menu-toggle[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile with JS: the menu is a glass panel over the content; the header keeps its height. */
  @media (max-width: 767px) {
    :global(.js) .menu-toggle {
      display: inline-grid;
    }

    :global(.js) .nav {
      position: fixed;
      inset-inline: 0;
      top: var(--header-h);
      z-index: 1;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: var(--space-4) calc(var(--space-8) + env(safe-area-inset-bottom));
      padding-inline: max(var(--space-6), env(safe-area-inset-left))
        max(var(--space-6), env(safe-area-inset-right));
      background: color-mix(in srgb, var(--color-bg) 78%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      border-bottom: 1px solid var(--color-border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--ease-out),
        visibility 0s linear var(--duration-fast);
    }

    :global(.js) .nav[data-open='true'] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    /* Scrim over the page; a click on it closes the menu (see the script). */
    :global(.js) .site-header::after {
      content: '';
      position: fixed;
      inset-inline: 0;
      top: var(--header-h);
      height: 100dvh;
      background: rgb(8 9 13 / 0.5);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-fast) var(--ease-out),
        visibility 0s linear var(--duration-fast);
    }

    :global(html[data-menu-open='true']) .site-header::after {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    :global(html[data-menu-open='true']) {
      overflow: hidden;
    }

    :global(.js) .nav ul {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.js) .nav a {
      font-size: 1.25rem;
      padding-inline: 0;
    }

    :global(.js) .nav-github {
      margin: var(--space-2) 0 0;
      padding: var(--space-2) 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }

    :global(.js) .github-label {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
    }
  }

  @media (max-width: 767px) {
    .brand-word {
      font-size: 1.3rem;
    }
  }
</style>
