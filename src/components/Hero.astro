---
import JupiterScene from './JupiterScene.astro';
import StarField from './StarField.astro';
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
import { localizePath, resolveLocale, useTranslations } from '../i18n';

interface Props {
  /** The most recent case study: concrete proof right under the tagline, updated as projects are added. */
  latest?: { title: string; href: string };
}

const { latest } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
// The `mission` object, flight notes and log are decorative code: they stay in English in every locale.
---

<section class="hero" aria-labelledby="hero-title" data-launchpad>
  <StarField />
  <JupiterScene />

  <!-- Flight layer (desktop, decorative): the script draws trails, rocket and waypoint here. -->
  <svg class="flight-layer" aria-hidden="true">
    <defs></defs>
  </svg>
  <div class="flyer" aria-hidden="true" hidden>
    <div class="flyer-body">
      <LogoMark size={52} />
    </div>
  </div>
  <div class="waypoint" aria-hidden="true" hidden>
    <span class="waypoint-cross"></span>
    <span class="waypoint-coords"></span>
    <span class="waypoint-note"></span>
  </div>

  <div class="container hero-inner">
    <div class="copy">
      <!-- Flight log: ruler with ticks and numbered entries (decorative). -->
      <div class="log" aria-hidden="true">
        <span class="log-head">log</span>
        <ol>
          <li>01</li>
          <li>02</li>
          <li>03</li>
        </ol>
        <span class="log-foot">sol 01</span>
      </div>

      <div class="content">
        <p class="path-label" aria-hidden="true">
          portfolio / <b>introduction.ts</b>
        </p>

        <h1 id="hero-title">
          <span>{t('hero.titleLine1')}</span>
          <span>
            {t('hero.titleLine2')} <em class="shine">{t('hero.titleHighlight')}</em>
          </span>
        </h1>

        <p class="identity">
          <strong>{site.person}</strong>
          <span>{t('hero.identity', { role: t('site.role'), focus: t('site.focus').toLowerCase() })}</span>
        </p>
        <p class="tagline">{t('site.tagline')}</p>
        {latest && (
          <p class="latest">
            {t('hero.latest')}{' '}
            <a class="link-underline" href={latest.href}>
              {latest.title}
            </a>
          </p>
        )}

        <div class="cta-row">
          <div class="actions">
            <a class="btn btn-primary" href={localizePath('/work/', locale)}>
              {t('hero.primaryCta')}
              <svg
                class="arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a class="link-underline" href={localizePath('/contact/', locale)}>
              {t('hero.secondaryCta')}
            </a>
          </div>

          <pre class="mission" aria-hidden="true"><code><span class="k">const</span> mission = {'{'}
  craft: <span class="s" data-field="craft">'products'</span>,
  target: <span class="n" data-field="target">'jupiter'</span>,
  status: <span class="s" data-field="status">'building'</span>,
{'}'}; <span class="c">// click the sky to launch</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<!--
  Outside the hero on purpose: the hero isolates its stacking context (isolation) and the projects
  section (z-index: 1) would sit above it. Fixed decorative layer for the rocket in transit; the FAB itself is BackToTop.astro (every page).
-->
<div class="sky" aria-hidden="true">
  <svg class="sky-trail"></svg>
  <div class="sky-rocket" hidden>
    <LogoMark size={52} />
  </div>
</div>

<script>
  // Rocket flight in the hero and its hand-over to the «Back to top» FAB (src/scripts/hero/).
  import { initHeroFlight } from '../scripts/hero/flight';
  import { initRocketFab } from '../scripts/hero/rocket-fab';

  const flight = initHeroFlight();
  if (flight) initRocketFab(flight);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Mobile: bottom space for the planet arc; the Jupiter crop (160–200 px visible) comes after
       the introduction and the CTAs (§9). */
    padding-block: var(--space-12) calc(clamp(160px, 48vw, 200px) + var(--space-10, 2.5rem));
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .copy {
    display: flex;
    gap: var(--space-6);
  }

  .log {
    display: none;
  }

  h1 {
    margin-top: var(--space-4);
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  h1 span {
    display: block;
  }

  /* .shine (the lavender word with its sweeping light) lives in global.css: CTA and titles use it. */
  .shine {
    font-style: normal;
  }

  .identity,
  .tagline {
    max-width: 40rem;
  }

  .identity {
    margin-top: var(--space-8);
    font-size: var(--text-lead);
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.4em;
  }

  .identity span {
    color: var(--color-text-muted);
  }

  .tagline {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  /* The evidence line: mono label, the project as a link. */
  .latest {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }

  .latest a {
    font-family: var(--font-sans);
    font-size: 1rem;
    min-height: 0;
  }

  /* CTAs and the `mission` block share a row when there is room; otherwise the code wraps below. */
  .cta-row {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-8) clamp(3rem, 5vw, 6rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  .actions .btn {
    min-width: 13.5rem;
  }

  /* ---------- `mission` object (live) ---------- */
  .mission {
    display: none;
  }

  .mission .k {
    color: var(--color-accent);
  }

  .mission .s {
    color: var(--color-jupiter);
  }

  .mission .n {
    color: var(--color-success);
  }

  .mission .c {
    color: var(--color-text-subtle);
  }

  .mission :global(.is-typing)::after {
    content: '';
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--color-accent);
  }

  /* ---------- Flight layer ---------- */
  .flight-layer,
  .flyer,
  .waypoint {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .flight-layer {
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .flight-layer :global(.trail-group) {
    transition: opacity 0.8s ease;
  }

  .flight-layer :global(.trail-group.is-leaving) {
    opacity: 0;
  }

  .flight-layer :global(.mask-path) {
    stroke: #fff;
    stroke-width: 8;
    stroke-linecap: round;
  }

  .flight-layer :global(.flight-dots) {
    stroke: var(--trail-dot-color);
    stroke-width: var(--trail-dot-size);
    filter: drop-shadow(0 0 2px rgb(21 22 30 / 0.9));
    stroke-dasharray: 1 var(--trail-dot-gap);
    stroke-linecap: round;
  }

  .flight-layer :global(.flight-solid) {
    stroke: rgb(198 165 255 / 0.85);
    stroke-width: 1.75;
    stroke-linecap: round;
    filter: drop-shadow(0 0 5px rgb(198 165 255 / 0.4));
  }

  .flyer {
    z-index: 3;
    width: 52px;
    height: 52px;
    color: var(--color-accent);
    will-change: transform;
  }

  .flyer[hidden],
  .waypoint[hidden] {
    display: none;
  }

  .flyer-body {
    transform: rotate(var(--angle, 0deg));
    filter: drop-shadow(0 0 10px rgb(18 19 26 / 0.9)) drop-shadow(0 0 18px rgb(121 80 232 / 0.6));
  }

  .waypoint {
    z-index: 3;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .waypoint.is-visible {
    opacity: 1;
  }

  .waypoint-cross {
    position: relative;
    width: 11px;
    height: 11px;
  }

  .waypoint-cross::before,
  .waypoint-cross::after {
    content: '';
    position: absolute;
    background: var(--color-text);
  }

  .waypoint-cross::before {
    left: 5px;
    top: 0;
    width: 1px;
    height: 11px;
  }

  .waypoint-cross::after {
    top: 5px;
    left: 0;
    width: 11px;
    height: 1px;
  }

  /* Own background: readable on top of the planet too. */
  .waypoint-coords,
  .waypoint-note {
    justify-self: start;
    padding: 2px var(--space-2);
    color: var(--color-text);
    border-radius: 6px;
    background: rgb(18 19 26 / 0.82);
  }

  .waypoint-note {
    grid-column: 2;
    border: 1px solid var(--color-accent);
  }

  .waypoint.is-flipped .waypoint-cross {
    grid-column: 2;
    grid-row: 1;
  }

  .waypoint.is-flipped .waypoint-coords {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }

  .waypoint.is-flipped .waypoint-note {
    grid-column: 1;
    justify-self: end;
  }

  @media (min-width: 1024px) {
    .hero {
      /* Bottom: room for the projects horizon (HorizonArc), which rises --horizon-depth in the
         centre, so it never covers the `mission` block or the log. The extra air drops the
         boundary with projects lower relative to the planet and the text. */
      padding-block: var(--space-16) calc(var(--space-24) + var(--horizon-depth));
      /* No 100vh: tall enough for the composition without pushing the projects down. */
      min-height: clamp(560px, 74vh, 720px);
    }

    .copy {
      max-width: 62%;
    }

    h1 {
      font-size: min(4.75rem, 4.4vw);
    }

    h1 span {
      white-space: nowrap;
    }

    /* Fixed width (the longest line it can hold, in ch of its own mono font): the values are
       rewritten on every flight, and a block that resized would reflow the CTA row and shift the
       hero under the rocket's trail. */
    .mission {
      display: block;
      flex: none;
      width: 36ch;
      overflow: hidden;
      margin: var(--space-6) 0 0;
      padding-left: var(--space-4);
      border-left: 1px dashed var(--color-control-border);
      font-size: 0.8125rem;
      line-height: 1.75;
      color: var(--color-text);
    }

    /* Log: faint vertical ruler with short ticks every 12 px and long ones every 48 px. */
    .log {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-4);
      width: var(--hero-log-w);
      flex-shrink: 0;
      padding: 0.15rem var(--space-4) 0 0;
      border-right: 1px solid var(--color-border);
      background:
        repeating-linear-gradient(to bottom, rgb(150 145 168 / 0.28) 0 1px, transparent 1px 48px) right top /
          12px 100% no-repeat,
        repeating-linear-gradient(to bottom, rgb(150 145 168 / 0.16) 0 1px, transparent 1px 12px) right top /
          6px 100% no-repeat;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-text-subtle);
      font-variant-numeric: tabular-nums;
    }

    .log ol {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
      margin: var(--space-2) 0 0;
      padding: 0;
      list-style: none;
      font-size: var(--text-meta);
    }

    .log-head,
    .log-foot {
      white-space: nowrap;
      opacity: 0.7;
      letter-spacing: 0.04em;
    }

    .log-foot {
      margin-top: auto;
    }
  }

  /* The sky is the launch area: crosshair there, the normal cursor over the text column. */
  @media (min-width: 1024px) and (pointer: fine) {
    .hero {
      cursor: crosshair;
    }

    .hero :is(.content, .log) {
      cursor: auto;
    }
  }

  /* ---------- Rocket in transit + «Back to top» FAB ---------- */
  /* Below the sticky header (z 50): the rocket passes behind it, not over it. */
  .sky {
    position: fixed;
    inset: 0;
    z-index: 49;
    pointer-events: none;
  }

  .sky-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sky-trail :global(circle) {
    fill: var(--color-accent);
  }

  .sky-rocket {
    position: absolute;
    top: 0;
    left: 0;
    width: 52px;
    height: 52px;
    color: var(--color-accent);
    transform-origin: 50% 50%;
    will-change: transform;
    filter: drop-shadow(0 0 10px rgb(21 22 30 / 0.9)) drop-shadow(0 0 16px rgb(121 80 232 / 0.55));
  }

  .sky-rocket[hidden] {
    display: none;
  }
</style>
