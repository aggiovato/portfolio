---
import { Image } from 'astro:assets';
import { projectLocale, projectPath, type Project } from '../lib/content/projects';
import { resolveLocale, useTranslations } from '../i18n';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}
const { project, headingLevel: H = 'h3', priority = false } = Astro.props;
const { data } = project;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const href = projectPath(project);
// Untranslated projects fall back to the default locale: say so and mark the language.
const contentLocale = projectLocale(project);
const isFallback = contentLocale !== locale;
const isDraft = data.publicationStatus === 'draft';
const tags = data.categories.length ? data.categories : [t(`project.type.${data.projectType}`)];
---

<article class="card">
  <div class="card-grid">
    <!-- The image links to the same place as the title; kept out of the tab order to avoid duplicates. -->
    <a
      class="preview"
      href={href}
      tabindex="-1"
      aria-hidden="true"
      style={`view-transition-name: cover-${data.slug}`}
    >
      {data.cover ? (
        <Image
          src={data.cover.src}
          alt=""
          widths={[480, 800, 1100]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          loading={priority ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="pending">
          <span class="pending-path">~/work/{data.slug}/cover</span>
          <span>{t('card.screenshotPending')}</span>
        </div>
      )}
    </a>

    <div class="body">
      {isDraft && <p class="draft">{t('card.draftDevOnly')}</p>}
      {isFallback && <p class="lang-note">{t('card.inDefaultLanguage')}</p>}
      <H
        class="title"
        style={`view-transition-name: title-${data.slug}`}
        lang={isFallback ? contentLocale : undefined}
      >
        <a href={href} hreflang={isFallback ? contentLocale : undefined}>
          {data.title}
        </a>
      </H>
      <p class="summary" lang={isFallback ? contentLocale : undefined}>
        {data.summary}
      </p>
      <ul class="chip-list" aria-label={t('card.categories')}>
        {tags.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </div>
  </div>
</article>

<style>
  .card {
    container-type: inline-size;
  }

  .card-grid {
    display: grid;
    gap: var(--space-6);
  }

  .preview {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-card-border);
    background: var(--color-card);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .preview :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card:hover .preview {
    border-color: var(--color-accent);
  }

  .pending {
    height: 100%;
    display: grid;
    place-content: center;
    gap: var(--space-2);
    text-align: center;
    color: var(--color-text-subtle);
    background:
      linear-gradient(var(--color-card-border) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--color-card-border) 1px, transparent 1px) 0 0 / 32px 32px;
    background-color: var(--color-card);
  }

  .pending-path {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-accent);
  }

  /* Dark pill: readable on graphite and on the brand band. */
  .draft {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 2px var(--space-2);
    border-radius: 6px;
    background: rgb(18 19 26 / 0.7);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: #ffb4bc;
  }

  .lang-note {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }

  .title {
    font-size: var(--text-h3);
    width: fit-content; /* box fitted to the text for the page transition */
  }

  .title a {
    text-decoration: none;
  }

  /* The whole card is clickable through the title link, without nested links. */
  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .summary {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  @container (min-width: 760px) {
    .card-grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      gap: var(--space-12);
    }
  }
</style>
