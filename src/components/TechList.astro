---
import type { Project } from '../lib/content/projects';
import { resolveLocale, useTranslations } from '../i18n';

interface Props {
  stack: Project['data']['stack'];
}
const { stack } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));
---

{stack.length > 0 && (
  <div class="table-wrap">
    <table role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">
            {t('stack.layer')}
          </th>
          <th role="columnheader" scope="col">
            {t('stack.technology')}
          </th>
          <th role="columnheader" scope="col">
            {t('stack.why')}
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {stack.map((s) => (
          <tr role="row">
            <td role="cell" class="layer">
              {t(`stack.layer.${s.layer}`)}
            </td>
            <td role="cell">
              <strong>{s.name}</strong>
              {s.usage !== 'production' && <span class="usage"> · {t(`stack.usage.${s.usage}`)}</span>}
            </td>
            <td role="cell" class="why">
              {s.rationale ?? '—'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .table-wrap {
    overflow-x: auto;
    margin-block: var(--space-6);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    text-align: left;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  th,
  .layer {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    color: var(--color-text-subtle);
  }
  /* «Why» is the column worth reading: full text colour, not muted. */
  .usage {
    color: var(--color-text-muted);
  }
  .why {
    color: var(--color-text);
  }

  /*
   * Phones: each technology becomes a stacked row (layer and name, then the reason) instead of
   * three cramped columns. Explicit roles keep the table semantics that a display change would
   * otherwise drop in some screen readers.
   */
  @media (max-width: 639px) {
    table,
    tbody,
    tr,
    td {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tr {
      display: grid;
      grid-template-columns: 6.5rem 1fr;
      gap: var(--space-1) var(--space-3);
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
    }
    td {
      padding: 0;
      border: 0;
    }
    .layer {
      padding-top: 0.2em;
    }
    .why {
      grid-column: 1 / -1;
    }
  }
</style>
