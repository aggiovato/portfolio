---
/**
 * Featured projects carousel (home).
 *
 * - No-JS baseline: list with native horizontal scroll + scroll-snap (wheel, trackpad, touch and
 *   arrow keys on the track, which is a focusable region).
 * - With JS: previous/next buttons and a «01 / 0N» counter, shown only when there are more
 *   projects than fit. No autoplay. Respects prefers-reduced-motion.
 * - Mobile (< 768 px): one column, no carousel (brief and §9: projects are read at a glance).
 * - Compact card: screenshot on top (the protagonist), title, one sentence (tagline → summary),
 *   2–3 tags and «View project». A single link per card (the title) that covers all of it.
 * - Width: centred block up to 1520 px (wider than the text). Heading, track and footer share
 *   the same edge: 2 cards visible on desktop, 1 + a peek on tablet.
 */
import { Image } from 'astro:assets';
import { projectLocale, projectPath, type Project } from '../lib/content/projects';
import { resolveLocale, useTranslations } from '../i18n';

interface Props {
  projects: Project[];
  /** id for aria-controls; unique per page. */
  id?: string;
}
const { projects, id = 'project-track' } = Astro.props;
const total = String(projects.length).padStart(2, '0');
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<div class="carousel" data-carousel>
  <div class="head">
    <slot name="heading" />
    <div class="controls" data-controls hidden>
      <span class="count" aria-hidden="true">
        <b data-current>01</b> / {total}
      </span>
      <button
        type="button"
        class="nav"
        data-prev
        aria-controls={id}
        aria-label={t('carousel.previous')}
        disabled
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </button>
      <button type="button" class="nav" data-next aria-controls={id} aria-label={t('carousel.next')}>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </div>

  <ul id={id} class="track" role="list" tabindex="0" aria-label={t('carousel.label')}>
    {projects.map((project, i) => {
      const { data } = project;
      const href = projectPath(project);
      // Untranslated projects fall back to the default locale: say so and mark the language.
      const contentLocale = projectLocale(project);
      const isFallback = contentLocale !== locale;
      const tags = (data.categories.length ? data.categories : [t(`project.type.${data.projectType}`)]).slice(
        0,
        3,
      );
      return (
        <li class="slide">
          <article class="pcard">
            <div class="media" style={`view-transition-name: cover-${data.slug}`}>
              {data.cover ? (
                <Image
                  src={data.cover.src}
                  alt=""
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 1100px) 26vw, (min-width: 768px) 44vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="pending">
                  <span class="pending-path">~/work/{data.slug}/cover</span>
                  <span>{t('card.screenshotPending')}</span>
                </div>
              )}
            </div>

            <div class="info">
              {data.publicationStatus === 'draft' && <p class="draft">{t('card.draft')}</p>}
              {isFallback && <p class="lang-note">{t('card.inDefaultLanguage')}</p>}
              <h3
                class="title"
                style={`view-transition-name: title-${data.slug}`}
                lang={isFallback ? contentLocale : undefined}
              >
                <a class="stretched" href={href} hreflang={isFallback ? contentLocale : undefined}>
                  {data.title}
                </a>
              </h3>
              <p class="tagline" lang={isFallback ? contentLocale : undefined}>
                {data.tagline ?? data.summary}
              </p>
              <ul class="chip-list" aria-label={t('card.categories')}>
                {tags.map((t, k) => (
                  <li class:list={['chip', k === 0 && 'chip--lead']}>{t}</li>
                ))}
              </ul>
              <span class="cta" aria-hidden="true">
                {t('card.viewProject')}
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </div>
          </article>
        </li>
      );
    })}
  </ul>

  <div class="foot">
    <slot name="footer" />
  </div>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = window.matchMedia('(min-width: 768px)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track');
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    if (!track || !controls || !prev || !next || !current) return;
    const slides = [...track.children] as HTMLElement[];

    const step = () => slides[0]?.getBoundingClientRect().width ?? track.clientWidth;

    let queued = false;
    const update = () => {
      queued = false;
      const max = track.scrollWidth - track.clientWidth;
      const overflows = wide.matches && max > 4;
      controls.hidden = !overflows;
      root.dataset.atStart = String(track.scrollLeft <= 4);
      root.dataset.atEnd = String(!overflows || track.scrollLeft >= max - 4);
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;
      // At the end the last card cannot align left (several fit): show the total.
      const atEnd = track.scrollLeft >= max - 4;
      const index = atEnd
        ? slides.length
        : Math.min(slides.length, Math.round(track.scrollLeft / step()) + 1);
      current.textContent = String(index).padStart(2, '0');
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    const go = (dir: 1 | -1) =>
      track.scrollBy({ left: dir * step(), behavior: reduced.matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  });
</script>

<style>
  /* Centred block, wider than the text container (up to 1520 px). */
  .carousel {
    --gap: var(--space-8);
    width: min(100% - 2 * var(--gutter), 1520px);
    margin-inline: auto;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-12);
  }

  .head :global(.section-heading) {
    margin-bottom: 0;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .controls[hidden] {
    display: none;
  }

  .count {
    margin-right: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .count b {
    font-weight: 500;
    color: var(--color-accent);
  }

  .nav {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-control-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* ---------- Track ---------- */
  .track {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track:focus-visible {
    outline-offset: 6px;
  }

  @media (min-width: 768px) {
    .track {
      flex-direction: row;
      gap: var(--gap);
      /* Vertical padding so the card focus ring is not clipped. */
      padding: var(--space-2) 0 var(--space-4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* Hints that there is more to the right until the end is reached. */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 72px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 72px), transparent);
    }

    .track::-webkit-scrollbar {
      display: none;
    }

    .carousel[data-at-end='true'] .track {
      -webkit-mask-image: none;
      mask-image: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .track {
        scroll-behavior: smooth;
      }
    }

    /* Tablet: one card and part of the next. */
    .slide {
      flex: 0 0 calc((100% - var(--gap)) / 1.25);
      scroll-snap-align: start;
    }
  }

  /* Desktop: two cards visible. */
  @media (min-width: 1100px) {
    .slide {
      flex-basis: calc((100% - var(--gap)) / 2);
    }
  }

  /* ---------- Card ----------
     With room (≥ 560 px card): screenshot on the left (~55 %) and description beside it.
     Without room: screenshot on top and description below. */
  .slide {
    container-type: inline-size;
  }

  .pcard {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-5, 1.25rem);
    height: 100%;
    border-radius: var(--radius-card);
  }

  @container (min-width: 560px) {
    /* Images top-aligned in every card; text is centred against its image. */
    .pcard {
      grid-template-columns: 1.22fr 1fr;
      align-items: start;
      gap: var(--space-8);
    }

    .info {
      align-self: center;
    }
  }

  .pcard:has(.stretched:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
  }

  .media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-card-border);
    background: var(--color-card);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.4s var(--ease-out);
  }

  .pending {
    height: 100%;
    display: grid;
    place-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    text-align: center;
    color: var(--color-text-subtle);
    font-size: 0.9375rem;
    background:
      linear-gradient(var(--color-card-border) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--color-card-border) 1px, transparent 1px) 0 0 / 28px 28px;
    background-color: var(--color-card);
  }

  .pending-path {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .info {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .draft {
    padding: 2px var(--space-2);
    border-radius: 6px;
    background: rgb(21 22 30 / 0.7);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-error);
  }

  .lang-note {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-subtle);
  }

  .title {
    font-size: var(--text-h3);
    width: fit-content; /* box fitted to the text for the page transition */
  }

  .stretched {
    text-decoration: none;
  }

  /* The whole card is the clickable area of the title link (no duplicated links). */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .stretched:focus-visible {
    outline: none;
  }

  .tagline {
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  .chip-list {
    margin-top: var(--space-2);
  }

  .chip--lead {
    border-color: rgb(198 165 255 / 0.45);
    background: rgb(198 165 255 / 0.12);
    color: var(--color-accent);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .cta svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .pcard:hover .media {
    border-color: var(--color-accent);
  }

  .pcard:hover .cta svg {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pcard:hover .media :global(img) {
      transform: scale(1.02);
    }
  }

  .foot:empty {
    display: none;
  }

  .foot {
    margin-top: var(--space-12);
  }
</style>
